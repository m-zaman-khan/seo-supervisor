{
  "name": "seo-supervisor",
  "version": "1.1.0",
  "description": "SEO audit, safe fixes, PR review and a launch gate for AI coding agents. Crawls any site, scores it 0-100 and writes a polished offline report.",
  "type": "module",
  "bin": {
    "seo-supervisor": "bin/seo-supervisor.mjs"
  },
  "files": [
    "bin/",
    "skills/",
    "commands/",
    ".claude-plugin/",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "demo": "node skills/seo-supervisor/scripts/render-report.mjs skills/seo-supervisor/examples/sample-audit.json --out docs/index.html --no-md && node skills/seo-supervisor/scripts/render-report.mjs skills/seo-supervisor/examples/sample-audit.json --out skills/seo-supervisor/examples/sample-report.html"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "seo",
    "technical-seo",
    "seo-audit",
    "claude-code",
    "claude-skills",
    "agent-skills",
    "claude-code-plugin",
    "crawler",
    "nextjs",
    "structured-data",
    "core-web-vitals",
    "ai-search"
  ],
  "homepage": "https://github.com/m-zaman-khan/seo-supervisor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-zaman-khan/seo-supervisor.git"
  },
  "bugs": {
    "url": "https://github.com/m-zaman-khan/seo-supervisor/issues"
  },
  "author": "Zaman Khan",
  "license": "MIT"
}
